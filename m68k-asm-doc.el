    ("sub" "Subtract" "destination = destination - source")
    ("suba" "Subtract Address" "subtract from an address register; flags unchanged")
    ("subi" "Subtract Immediate" "subtract an immediate value")
    ("subq" "Subtract Quick" "subtract 1 to 8")
    ("subx" "Subtract Extended" "subtract with the X flag, for multi-word arithmetic")
    ("swap" "Swap Register Halves" "exchange the high and low words of Dn")
    ("tas" "Test and Set" "test a byte and set its bit 7 atomically (avoid on the Amiga bus)")
    ("trap" "Trap" "take one of the 16 TRAP exception vectors")

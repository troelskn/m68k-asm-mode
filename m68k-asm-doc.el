(defconst m68k-asm-doc--rounded-fpu-operations
  '("abs" "add" "div" "move" "mul" "neg" "sqrt" "sub")
  "FPU operations that also come as FSxxx and FDxxx (040+).
Those round the result to single or double precision.")


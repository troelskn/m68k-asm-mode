    ("mi" "Minus" "N = 1: result < 0")
    ("ge" "Greater or Equal" "signed >=")
    ("lt" "Less Than" "signed <")
    ("gt" "Greater Than" "signed >")
    ("le" "Less or Equal" "signed <="))
  "Integer condition codes: suffix, name, meaning.")

(defconst m68k-asm-doc--fpu-conditions
  '(("f" "False") ("eq" "Equal") ("ogt" "Ordered Greater Than") ("oge" "Ordered Greater or Equal")
    ("olt" "Ordered Less Than") ("ole" "Ordered Less or Equal") ("ogl" "Ordered Greater or Less")
    ("or" "Ordered") ("un" "Unordered") ("ueq" "Unordered or Equal")
    ("ugt" "Unordered or Greater Than") ("uge" "Unordered or Greater or Equal")
    ("ult" "Unordered or Less Than") ("ule" "Unordered or Less or Equal") ("ne" "Not Equal")
    ("t" "True") ("sf" "Signaling False") ("seq" "Signaling Equal") ("gt" "Greater Than")
    ("ge" "Greater or Equal") ("lt" "Less Than") ("le" "Less or Equal") ("gl" "Greater or Less")
    ("gle" "Greater, Less or Equal") ("ngle" "Not Greater, Less or Equal")
    ("ngl" "Not Greater or Less") ("nle" "Not Less or Equal") ("nlt" "Not Less Than")
    ("nge" "Not Greater or Equal") ("ngt" "Not Greater Than") ("sne" "Signaling Not Equal")
    ("st" "Signaling True"))
  "FPU condition codes: suffix, name.  \"Unordered\" means a NaN was involved.")

(defconst m68k-asm-doc--table
  (let ((table (make-hash-table :test #'equal)))
    (dolist (entry m68k-asm-doc--operations)
      (puthash (car entry) (cons 'instruction (cdr entry)) table))
    (dolist (entry m68k-asm-doc--directives)
      (puthash (car entry) (cons 'directive (cdr entry)) table))
    (dolist (op m68k-asm-doc--rounded-fpu-operations)
      (pcase-let ((`(,_ ,name ,description) (gethash (concat "f" op) table)))
        (puthash (concat "fs" op)
                 (list 'instruction name (concat description "; result rounded to single (040+)"))
                 table)
        (puthash (concat "fd" op)
                 (list 'instruction name (concat description "; result rounded to double (040+)"))
                 table)))
    (pcase-dolist (`(,cc ,name ,meaning) m68k-asm-doc--conditions)
      (unless (member cc '("t" "f"))      ; BT/BF do not exist; BRA is "branch always"
        (puthash (concat "b" cc) (list 'instruction (concat "Branch if " name)
                                       (format "branch if %s" meaning))
                 table))
      (puthash (concat "db" cc)
               (list 'instruction (concat "Decrement and Branch unless " name)
                     (format "loop: unless %s, Dn.w - 1 and branch while it is not -1" meaning))
               table)
      (puthash (concat "s" cc) (list 'instruction (concat "Set if " name)
                                     (format "byte = $FF if %s, else 0" meaning))
               table)
      (puthash (concat "trap" cc) (list 'instruction (concat "Trap if " name)
                                        (format "TRAPcc exception if %s (020+)" meaning))
               table))
    (pcase-dolist (`(,cc ,name) m68k-asm-doc--fpu-conditions)
      (puthash (concat "fb" cc) (list 'instruction (concat "FP Branch if " name)
                                      "branch on the FPU condition")
               table)
      (puthash (concat "fdb" cc) (list 'instruction (concat "FP Decrement and Branch unless " name)
                                       "loop: unless the FPU condition, Dn.w - 1 and branch while not -1")
               table)
      (puthash (concat "fs" cc) (list 'instruction (concat "FP Set if " name)
                                      "byte = $FF if the FPU condition holds, else 0")
               table)
      (puthash (concat "ftrap" cc) (list 'instruction (concat "FP Trap if " name)
                                         "exception if the FPU condition holds")
               table))
    ;; where the generated wording reads oddly
    (puthash "dbf" '(instruction "Decrement and Branch" "Dn.w - 1; branch unless it is now -1 (same as DBRA)")
             table)
    (puthash "st" '(instruction "Set" "byte = $FF") table)
    (puthash "sf" '(instruction "Clear Byte" "byte = 0") table)
    table)
  "Mnemonic to (KIND NAME DESCRIPTION).")

(defun m68k-asm-doc--branch-p (mnemonic)
  (string-match-p "\\`\\(?:f?b[a-z]+\\)\\'" mnemonic))

(defun m68k-asm-doc--size (mnemonic suffix)
  "What SUFFIX (a letter) means on MNEMONIC."
  (let ((fpu (and (string-prefix-p "f" mnemonic)
                  (eq (car (gethash mnemonic m68k-asm-doc--table)) 'instruction))))
    (cond
     ((and (m68k-asm-doc--branch-p mnemonic)
           (not (member mnemonic '("bchg" "bclr" "bset" "btst" "bkpt")))
           (not (string-prefix-p "bf" mnemonic)))
      (pcase suffix
        ((or "s" "b") "short, 8-bit displacement")
        ("w" "16-bit displacement")
        ("l" "32-bit displacement (020+)")))
     (fpu
      (pcase suffix
        ("b" "byte integer") ("w" "word integer") ("l" "long integer")
        ("s" "single precision, 32 bits") ("d" "double precision, 64 bits")
        ("x" "extended precision, 96 bits") ("p" "packed decimal")))
     (t
      (pcase suffix
        ("b" "byte (8 bits)") ("w" "word (16 bits)") ("l" "long (32 bits)"))))))

(defun m68k-asm-doc--macro-line (name)
  "Line number where macro NAME is defined in this buffer, or nil."
  (save-excursion
    (save-restriction
      (widen)
      (goto-char (point-min))
      (let ((case-fold-search nil))
        (when (re-search-forward (concat "^" (regexp-quote name) ":?[ \t]+[mM][aA][cC][rR][oO]\\_>") nil t)
          (line-number-at-pos))))))

(defun m68k-asm-doc--line-operation ()
  "The operation on the current line, as (WRITTEN OPERATION SUFFIX), or nil.
WRITTEN is the operation as it appears in the source, size suffix included;
OPERATION is the same without the suffix.  SUFFIX is the suffix letter in
lower case, or nil."
  (save-excursion
    (beginning-of-line)
    (when (let ((case-fold-search t))
            (looking-at (concat m68k-asm--label-prefix
                                "\\(\\([[:alpha:]_][[:alnum:]_$]*\\)\\(?:\\.\\([[:alpha:]]\\)\\)?\\)\\_>")))
      (list (match-string-no-properties 1)
            (match-string-no-properties 2)
            (and (match-beginning 3) (downcase (match-string-no-properties 3)))))))

(defun m68k-asm-doc--describe-line ()
  "Description of the operation on the current line, or nil."
  (pcase (m68k-asm-doc--line-operation)
    (`(,written ,operation ,suffix)
     (let* ((mnemonic (downcase operation))
            (entry (gethash mnemonic m68k-asm-doc--table))
            (shown (propertize written 'face (if entry 'font-lock-keyword-face 'm68k-asm-macro-face))))
       (if entry
           (let ((size (and suffix (m68k-asm-doc--size mnemonic suffix))))
             (format "%s  %s%s: %s" shown (nth 1 entry)
                     (if size (concat ", " size) "")
                     (nth 2 entry)))
         (let ((line (m68k-asm-doc--macro-line operation)))
           (if line
               (format "%s  macro, defined on line %d" shown line)
             (format "%s  macro, or an operation this mode does not know" shown))))))))

;;;###autoload
(defun m68k-asm-doc-eldoc (&rest _)
  "Eldoc backend for `m68k-asm-mode': describe the current line's operation."
  (when m68k-asm-describe-operations
    (m68k-asm-doc--describe-line)))

(provide 'm68k-asm-doc)
;;; m68k-asm-doc.el ends here

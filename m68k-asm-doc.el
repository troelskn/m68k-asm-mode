    ("facos" "FP Arc Cosine" "FPn = acos(source)")
    ("fadd" "FP Add" "FPn = FPn + source")
    ("fasin" "FP Arc Sine" "FPn = asin(source)")
    ("fatan" "FP Arc Tangent" "FPn = atan(source)")
    ("fatanh" "FP Hyperbolic Arc Tangent" "FPn = atanh(source)")
    ("fcmp" "FP Compare" "set the FPU flags from FPn - source")

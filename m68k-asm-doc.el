;;; m68k-asm-doc.el --- Plain-language names of 680x0 operations, via eldoc  -*- lexical-binding: t -*-

;;; Commentary:
;; For `m68k-asm-mode': as point moves, the echo area names the operation on
;; the current line and says what it does, e.g.
;;   moveq.l  Move Quick, long (32 bits): load a sign-extended 8-bit immediate (-128..127) into Dn
;; Condition codes are spelt out (bne: "Branch if Not Equal"), and so is the
;; size suffix, which means a displacement size on a branch and a number
;; format on an FPU instruction.  A macro call says where the macro is defined.
;;
;; The directive descriptions are checked against the vasm manual (vasm 2.0f,
;; chapter 4.5 "Mot Syntax Module: Directives" and the M68k backend's
;; directives): http://sun.hasenbraten.de/vasm/release/vasm.pdf
;; Directives the manual leaves out (endc, global, entry, extrn, import, export,
;; module, image, ifmi, ifpl, auto, mask2, symdebug, jumperr, jumpptr, dsource,
;; vdebug) are described from vasm's directive table in syntax/mot/syntax.c.
;;
;; It is an eldoc backend.  C-c C-d in m68k-asm-mode turns it on and off;
;; `m68k-asm-describe-operations' says whether it starts on.

;;; Code:

(require 'm68k-asm-mode)

